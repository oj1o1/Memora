# Optional: AI extraction (record/recall works without it)
GROQ_API_KEY=gsk_your_key_here

# Optional: override default database location (~/.memora/decisions.db)
# MEMORA_DB_PATH=~/.memora/decisions.db

# Optional: dashboard host/port
# MEMORA_HOST=127.0.0.1
# MEMORA_PORT=8377

# --- Cloud mode (optional) ---
# Set MEMORA_API_URL to use a remote Memora server instead of local SQLite.
# When set, the CLI, MCP server, and adapters all talk to this API.
# MEMORA_API_URL=https://your-app.vercel.app
# MEMORA_API_KEY=your_secret_key

# --- Turso cloud database (future) ---
# Set MEMORA_CLOUD_MODE=true to use Turso/libSQL instead of local SQLite.
# Requires: pip install memora[turso]
# MEMORA_CLOUD_MODE=false
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_token
